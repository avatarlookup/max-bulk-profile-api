{
  "name": "MAX Bulk Number Profile",
  "brand": "AvatarLookup",
  "repository": "avatarlookup/max-bulk-profile-api",
  "description": "Upload numbers and download the MAX profile data, avatar included.",
  "official_site": "https://avatarlookup.com",
  "landing_page": "https://avatarlookup.com/products/max_profile_batch",
  "canonical_docs": "https://avatarlookup.com/api-docs",
  "base_url": "https://avatarlookup.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "max_profile_batch",
  "identifier_kind": "phone",
  "requires_country": true,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 100000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "number",
      "example": "17253100591",
      "description": ""
    },
    {
      "name": "activated",
      "example": "yes",
      "description": ""
    },
    {
      "name": "id",
      "example": "52028987",
      "description": ""
    },
    {
      "name": "name",
      "example": "Alex Kim",
      "description": ""
    },
    {
      "name": "last_seen",
      "example": "unknown",
      "description": ""
    },
    {
      "name": "avatar",
      "example": "https://i.oneme.ru/i?r=example",
      "description": ""
    },
    {
      "name": "gender",
      "example": "male",
      "description": ""
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://avatarlookup.com/pricing",
  "maintainer": "AvatarLookup",
  "license": "MIT",
  "last_reviewed": "2026-09-22"
}
